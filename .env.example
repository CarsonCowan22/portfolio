# Copy to .env.local for local dev (gitignored, never committed) and set the real values
# in Vercel (Project Settings -> Environment Variables) for production.

# Password to enter the private /dashboard/job-hunt dashboard. Pick anything.
JOB_HUNT_DASHBOARD_PASSWORD=

# Random secret used to sign the auth cookie -- not the password itself. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_HUNT_COOKIE_SECRET=

# Fine-grained GitHub PAT scoped ONLY to the CarsonCowan22/carson-job-hunt repo, with
# "Contents: Read-only" repository permission and nothing else. Create at
# https://github.com/settings/personal-access-tokens/new
JOB_HUNT_GH_TOKEN=

# --- Private budget tool (/budget, or the budget.<your-domain> subdomain) ---

# Postgres connection string (Neon or Vercel Postgres both work -- any standard Postgres URL).
# Include "?sslmode=require" for hosted providers; Neon's own connection strings already do.
DATABASE_URL=

# Password to enter the private budget tool. Pick anything -- different from JOB_HUNT_DASHBOARD_PASSWORD.
BUDGET_DASHBOARD_PASSWORD=

# Random secret used to sign the budget auth cookie -- not the password itself, and a different
# value from JOB_HUNT_COOKIE_SECRET so the two logins stay independent. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUDGET_COOKIE_SECRET=
